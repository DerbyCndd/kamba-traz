# Supabase → Project Settings → API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave "anon" ou "publishable". Nunca uses aqui a chave service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço do site (usado nos links dos emails). Em produção, o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do limite de tentativas. Gera um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tem de ser igual ao que pões em supabase/secret.local.sql (ver supabase/rate-limit.sql).
RATE_LIMIT_SECRET=

# Resumo diário da equipa (ver README, «Monitorização»). Todos opcionais, menos o CRON_SECRET.
# CRON_SECRET: segredo que a Vercel envia ao chamar o resumo (mínimo 16 caracteres; gera com o mesmo comando acima).
CRON_SECRET=
# Receber por Telegram (crie um bot com o @BotFather e veja o seu chat id):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ou por email, com a Resend (resend.com):
RESEND_API_KEY=
DIGEST_EMAIL=
DIGEST_FROM=

# Emails às duas partes em cada mudança de estado da entrega (usa a RESEND_API_KEY e o RATE_LIMIT_SECRET acima).
# Remetente, por exemplo "Kamba Traz <avisos@o-teu-dominio>" (domínio verificado na Resend). Vazio = usa DIGEST_FROM.
NOTIFY_FROM=

# Erros da app (opcional): DSN do projeto no sentry.io. Sem isto, o Sentry fica desligado.
NEXT_PUBLIC_SENTRY_DSN=

# Chave de cifra dos documentos, moradas e familiares (BI, passaporte...). Sem ela não se guardam identificações.
# Guarda-a num sítio seguro: perdê-la torna ilegível o que já está cifrado. Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_KEY=
